{
  "name": "lumina-ai",
  "version": "2.5.0",
  "private": true,
  "scripts": {
    "dev:backend": "python -m uvicorn app:app --host 127.0.0.1 --port 8999 --reload",
    "dev:frontend": "next dev -p 3000",
    "dev": "concurrently -k -n \"FASTAPI,NEXTJS\" -c \"magenta.bold,cyan.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "typescript": "^5"
  }
}
